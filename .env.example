# ============================================
# KULAQR - Variables d'environnement
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# CRON JOB SECURITY
# ============================================
# Clé secrète pour sécuriser l'endpoint de vérification des abonnements
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-random-secret-key-here

# ============================================
# EXEMPLE DE GÉNÉRATION DE CLÉS
# ============================================
# Pour générer une clé CRON_SECRET sécurisée:
# 
# Méthode 1 (Node.js):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Méthode 2 (OpenSSL):
# openssl rand -hex 32
#
# Méthode 3 (Online):
# https://www.uuidgenerator.net/api/guid
#
# Résultat attendu: une chaîne aléatoire de 64 caractères hexadécimaux
# Exemple: a7f3c9e2b1d4f8a6c3e7b9d2f4a8c6e3b7d9f2a4c8e6b3d7f9a2c4e8b6d3f7a9

# ============================================
# CONFIGURATION VERCEL (optionnel)
# ============================================
# Ces variables doivent aussi être configurées dans:
# Vercel Dashboard → Settings → Environment Variables
#
# Variables à ajouter:
# - SUPABASE_URL
# - SUPABASE_KEY  
# - SUPABASE_SERVICE_ROLE_KEY
# - CRON_SECRET
#
# ⚠️ Important: Cocher Production, Preview, Development pour chaque variable

# ============================================
# NOTES DE SÉCURITÉ
# ============================================
# ❌ NE JAMAIS commiter le fichier .env dans git
# ✅ Toujours utiliser .env.example pour la documentation
# ✅ Régénérer les clés si elles sont exposées
# ✅ Utiliser des clés différentes pour dev/staging/production
